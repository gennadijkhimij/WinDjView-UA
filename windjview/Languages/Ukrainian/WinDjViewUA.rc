IDR_MAINFRAME MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Відкрити...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "За&крити\tCtrl+W",            ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "&Налаштування...\tCtrl+,",       ID_FILE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Історія",                     ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Ви&хід\tCtrl+Q",              ID_APP_EXIT
    END
    POPUP "&Вигляд"
    BEGIN
        MENUITEM "&Панель інструментів",        ID_VIEW_TOOLBAR
        MENUITEM "&Рядок стану",           ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        POPUP "Мо&ва (Language)"
        BEGIN
            MENUITEM "&English",                    ID_LANGUAGE_FIRST
        END
    END
    POPUP "Ві&кно"
    BEGIN
        MENUITEM "&На повний екран\tCtrl+L",    ID_VIEW_FULLSCREEN
        MENUITEM SEPARATOR
        MENUITEM "Перемкнутися на це вікно",   ID_WINDOW_ACTIVATE_FIRST
    END
    POPUP "&Довідка"
    BEGIN
        MENUITEM "Пе&ревірити оновлення...",    ID_CHECK_FOR_UPDATE
        MENUITEM "&Про програму WinDjView...",   ID_APP_ABOUT
    END
END

IDR_DjVuTYPE MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Відкрити...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "&Зберегти копію як...\tCtrl+S", ID_FILE_SAVE_COPY_AS
        MENUITEM "За&крити\tCtrl+W",            ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "&Імпорт закладок...",         ID_FILE_IMPORT_BOOKMARKS
        MENUITEM "Е&кспорт закладок...",        ID_FILE_EXPORT_BOOKMARKS
        MENUITEM "&Експортувати текст...",          ID_FILE_EXPORT_TEXT
        MENUITEM "&Друк...\tCtrl+P",          ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "Вла&стивості документа...",  ID_FILE_DOC_PROPERTIES
        MENUITEM "&Налаштування...\tCtrl+,",       ID_FILE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Історія",                     ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Ви&хід\tCtrl+Q",              ID_APP_EXIT
    END
    POPUP "&Редагування"
    BEGIN
        MENUITEM "С&копіювати текст\tCtrl+C",         ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "Додати &закладку...\tCtrl+B", ID_BOOKMARK_ADD
        MENUITEM SEPARATOR
        MENUITEM "П&означити виділене...\tCtrl+H", ID_HIGHLIGHT_SELECTION
        MENUITEM "&Експорт виділеного...",       ID_EXPORT_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "&Пошук...\tCtrl+F",           ID_EDIT_FIND
    END
    POPUP "&Вигляд"
    BEGIN
        MENUITEM "&Панель інструментів",        ID_VIEW_TOOLBAR
        MENUITEM "Панель &вкладок",             ID_VIEW_TAB_BAR
        MENUITEM "&Рядок стану",           ID_VIEW_STATUS_BAR
        MENUITEM "&Бічна панель",             ID_VIEW_SIDEBAR
        MENUITEM SEPARATOR
        MENUITEM "&На повний екран\tCtrl+L",    ID_VIEW_FULLSCREEN
        MENUITEM SEPARATOR
        MENUITEM "Сторінка &цілком\tCtrl+0",   ID_ZOOM_FITPAGE
        MENUITEM "По &ширині\tCtrl+2",          ID_ZOOM_FITWIDTH
        MENUITEM "&Розтягнути\tCtrl+3",          ID_ZOOM_STRETCH
        MENUITEM "&Початковий розмір\tCtrl+4",    ID_ZOOM_ACTUALSIZE
        POPUP "&Масштаб"
        BEGIN
            MENUITEM "&Збільшити\tCtrl+Плюс",       ID_ZOOM_IN
            MENUITEM "З&меншити\tCtrl+Мінус",      ID_ZOOM_OUT
            MENUITEM SEPARATOR
            MENUITEM "&50%",                        ID_ZOOM_50
            MENUITEM "&75%",                        ID_ZOOM_75
            MENUITEM "&100%\tCtrl+1",               ID_ZOOM_100
            MENUITEM "&200%",                       ID_ZOOM_200
            MENUITEM "&400%",                       ID_ZOOM_400
            MENUITEM SEPARATOR
            MENUITEM "&Інший...\tCtrl+M",          ID_ZOOM_CUSTOM
        END
        MENUITEM SEPARATOR
        POPUP "&Перехід"
        BEGIN
            MENUITEM "На пе&ршу сторінку\tCtrl+Home", ID_VIEW_FIRSTPAGE
            MENUITEM "На &попередню сторінку\tCtrl+PgUp", ID_VIEW_PREVIOUSPAGE
            MENUITEM "На &наступну сторінку\tCtrl+PgDn", ID_VIEW_NEXTPAGE
            MENUITEM "На &останню сторінку\tCtrl+End", ID_VIEW_LASTPAGE
            MENUITEM "&Вибрати сторінку...\tCtrl+G", ID_VIEW_GOTO_PAGE
            MENUITEM SEPARATOR
            MENUITEM "Наза&д\tAlt+стрілка вліво",   ID_VIEW_BACK
            MENUITEM "Впе&ред\tAlt+стрілка вправо", ID_VIEW_FORWARD
        END
        POPUP "П&оворот"
        BEGIN
            MENUITEM "В&ліво\tCtrl+Shift+стрілка вліво", ID_ROTATE_LEFT
            MENUITEM "В&право\tCtrl+Shift+стрілка вправо", ID_ROTATE_RIGHT
            MENUITEM "&180°\tCtrl+Shift+стрілка донизу", ID_ROTATE_180
        END
        POPUP "&Розташування"
        BEGIN
            MENUITEM "&Підряд\tCtrl+Alt+1", ID_LAYOUT_CONTINUOUS
            MENUITEM "&Сусідні\tCtrl+Alt+2",       ID_LAYOUT_FACING
            MENUITEM SEPARATOR
            MENUITEM "Перша сторінка &окремо\tCtrl+E", ID_LAYOUT_FIRSTPAGE_ALONE
            MENUITEM "Порядок справа &наліво\tCtrl+R", ID_LAYOUT_RTL_ORDER
        END
        POPUP "&Режим"
        BEGIN
            MENUITEM "&Кольоровий\tCtrl+Shift+1",      ID_DISPLAY_COLOR
            MENUITEM "Чорно-&білий\tCtrl+Shift+2",  ID_DISPLAY_BW
            MENUITEM "&Задній план\tCtrl+Shift+3",  ID_DISPLAY_BACKGROUND
            MENUITEM "&Передній план\tCtrl+Shift+4", ID_DISPLAY_FOREGROUND
        END
        MENUITEM SEPARATOR
        POPUP "Мо&ва (Language)"
        BEGIN
            MENUITEM "&English",                    ID_LANGUAGE_FIRST
        END
    END
    POPUP "&Інструменти"
    BEGIN
        MENUITEM "Режим &перетягування",       ID_MODE_DRAG
        MENUITEM "Виділити &текст",             ID_MODE_SELECT
        MENUITEM "Виділити &область",           ID_MODE_SELECT_RECT
        MENUITEM "Режим &збільшення",           ID_MODE_MAGNIFY
        MENUITEM "Виділити та з&масштабувати",  ID_MODE_ZOOM_RECT
    END
    POPUP "Ві&кно"
    BEGIN
        MENUITEM "&Каскадом",                   ID_WINDOW_CASCADE
        MENUITEM "У вигляді &горизонтальних смуг", ID_WINDOW_TILE_HORZ
        MENUITEM "У вигляді &вертикальних смуг",  ID_WINDOW_TILE_VERT
        MENUITEM SEPARATOR
        MENUITEM "&На повний екран\tCtrl+L",    ID_VIEW_FULLSCREEN
        MENUITEM SEPARATOR
        MENUITEM "Перемкнутися на це вікно",   ID_WINDOW_ACTIVATE_FIRST
    END
    POPUP "&Довідка"
    BEGIN
        MENUITEM "Пе&ревірити оновлення...",    ID_CHECK_FOR_UPDATE
        MENUITEM "&Про програму WinDjView...",   ID_APP_ABOUT
    END
END

IDR_POPUP MENU
BEGIN
    POPUP "Сторінка"
    BEGIN
        MENUITEM "&Скопіювати текст",           ID_EDIT_COPY
        MENUITEM "&Позначити текст...",          ID_HIGHLIGHT_TEXT
        MENUITEM "&Позначити виділене...",      ID_HIGHLIGHT_SELECTION
        MENUITEM "Експорт &виділеного...",       ID_EXPORT_SELECTION
        MENUITEM "&Масштабувати за виділеним",       ID_ZOOM_TO_SELECTION
        MENUITEM "&Параметри анотації...",     ID_ANNOTATION_EDIT
        MENUITEM "&Видалити анотацію",          ID_ANNOTATION_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Додати &закладку...",       ID_BOOKMARK_ADD
        MENUITEM SEPARATOR
        MENUITEM "&Інформація про сторінку",      ID_PAGE_INFORMATION
        MENUITEM "&Експорт сторінки...",        ID_EXPORT_PAGE
    END
    POPUP "Закладка"
    BEGIN
        MENUITEM "&Перейменувати",              ID_BOOKMARK_RENAME
        MENUITEM "&Видалити",                    ID_BOOKMARK_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Перемістити &вгору",          ID_BOOKMARK_MOVEUP
        MENUITEM "Перемістити в&низ",           ID_BOOKMARK_MOVEDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Перенаправити",              ID_BOOKMARK_SETDESTINATION
    END
    POPUP "Налаштування мініатюр"
    BEGIN
        MENUITEM "&Друк сторінок...",          ID_THUMBNAILS_PRINT
        MENUITEM "Е&кспорт сторінок...",         ID_THUMBNAILS_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Збільшити мініатюри",        ID_THUMBNAILS_ENLARGE
        MENUITEM "З&меншити мініатюри",        ID_THUMBNAILS_REDUCE
    END
    POPUP "Налаштування закладок"
    BEGIN
        MENUITEM "&Розгорнути закладки верхнього рівня", ID_BOOKMARK_TOP_LEVEL
        MENUITEM "&Переносити довгі закладки", ID_BOOKMARK_WRAP
    END
    POPUP "Вкладка"
    BEGIN
        MENUITEM "&Закрити вкладку",            ID_TAB_CLOSE
        MENUITEM "Закрити &інші вкладки",  ID_TAB_CLOSE_OTHER
    END
END


