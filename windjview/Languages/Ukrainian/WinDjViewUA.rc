IDD_ABOUTBOX DIALOGEX 0, 0, 287, 159
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Про програму WinDjView"
FONT 8, "MS Shell Dlg", 0, 0, 0xCC
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,9,9,20,20
    LTEXT           "WinDjView",IDC_STATIC_VERSION,40,7,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2004-2015 Андрій Жежерун",IDC_STATIC,40,17,171,8
    LTEXT           "Copyright (C) 2012-2015 Леонід Жежерун",IDC_STATIC,40,27,171,8
    LTEXT           "WinDjView-UA — модифікована версія WinDjView.",IDC_STATIC,40,37,240,8,SS_NOPREFIX
    LTEXT           "© 2026 Хімій Геннадій — локалізація, оновлення, зміни та виправлення.",IDC_STATIC,40,47,240,16,SS_NOPREFIX
    DEFPUSHBUTTON   "Закрити",IDOK,230,7,50,14,WS_GROUP
    LTEXT           "Сторінка проєкту:",IDC_STATIC,40,73,69,8
